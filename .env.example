# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=vpspilot
DB_USER=vpspilot
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Metrics API token — shared secret for this VPS instance.
# Use the same value when registering this server as a remote VPS on another installation.
METRICS_API_TOKEN=generate-a-long-random-token-here

# Login redirect
LOGIN_URL=/login/
LOGIN_REDIRECT_URL=/dashboard/
